# Copy to `.env` and adjust. Never commit the real `.env`.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: "mysql" (default) or "sqlite" (file db.sqlite3).
# For MySQL: create an empty database first, e.g.
#   CREATE DATABASE dbshop CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# then fill in the DB_* values below.
DB_ENGINE=mysql
DB_NAME=dbshop
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ZarinPal (sandbox merchant ids are any valid UUID)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True

# Kavenegar SMS. Leave empty in development: no SMS is sent, the activation code is only
# stored in the database (table accounts_customuser, column active_code).
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
